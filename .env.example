# Environment of server (SRS - Core §3.1) and card-auth (SRS - Card Spend §3.1). Copy to .env; .env is ignored by git.
# Required variables have no value here. Optional ones are commented out with their default.

# Standard base64 of exactly 32 bytes.
CAS_MASTER_KEY=
# CAS_MASTER_KEY_VERSION=1

# PostgreSQL, role cas_server.
DATABASE_URL=
# DB_POOL_MAX_CONNS=10
# DB_POOL_MIN_CONNS=2

# GRPC_PORT=50053
# HEALTH_HTTP_PORT=8091

# LOG_LEVEL=info
# LOG_FORMAT=json

# Go durations, such as 30s or 1h.
# SHUTDOWN_TIMEOUT=15s
# SYNC_TICK=1s
# SYNC_WORKERS=4
# SYNC_MAX_PAGES_PER_RUN=20
# SYNC_LOCK_RETRY=10s
# SYNC_FAILURE_THRESHOLD=5
# SYNC_BACKOFF_INITIAL=30s
# SYNC_BACKOFF_MAX=1h
# TRIGGER_SYNC_COOLDOWN=60s
# KEY_CHECK_INTERVAL=24h

# Development and demo only.
# ENABLE_FAKE_SOURCE=false

# Allow-list of test networks: chain IDs separated by commas (SRS - EVM Connector §3.1).
# EVM_ALLOWED_CHAIN_IDS=31337,84532

# card-auth (SRS - Card Spend §3.1). EVM_ALLOWED_CHAIN_IDS, LOG_LEVEL and LOG_FORMAT above apply to it too.

# PostgreSQL, role cas_card_auth.
CARD_AUTH_DATABASE_URL=
# CARD_AUTH_DB_POOL_MAX_CONNS=10
# CARD_AUTH_DB_POOL_MIN_CONNS=2

# Operator key: 32 bytes as 64 hexadecimal characters, 0x optional. Test networks only; never a personal wallet.
OPERATOR_PRIVATE_KEY=

# Network: CARD_AUTH_CHAIN_ID must be in EVM_ALLOWED_CHAIN_IDS. The RPC URLs may carry an API key.
CARD_AUTH_CHAIN_ID=
CARD_AUTH_RPC_URL=
# CARD_AUTH_RPC_FALLBACK_URL=
# CARD_AUTH_RPC_WS_URL=
# CARD_AUTH_RPC_FALLBACK_AFTER=3
# CARD_AUTH_RPC_READ_TIMEOUT=500ms

# Contract and funding token, checked at start.
CARD_AUTH_CONTROLLER_ADDRESS=
CARD_AUTH_TOKEN_ADDRESS=
# From 0 to 18.
CARD_AUTH_TOKEN_DECIMALS=

# Decision. CARD_AUTH_DEBIT_VALIDITY must be at least CARD_AUTH_DECISION_DEADLINE + 1s.
# CARD_AUTH_DECISION_DEADLINE=2.5s
# CARD_AUTH_DEBIT_VALIDITY=4s
# CARD_AUTH_RECEIPT_POLL_INTERVAL=200ms
# CARD_AUTH_QUOTE_BUFFER_BPS=100
# CARD_AUTH_LISTENER_SUBSCRIPTION=pendingLogs

# Finality: confirmations or tag; the tag (finalized or safe) is used in mode tag.
# CARD_AUTH_FINALITY_MODE=confirmations
# CARD_AUTH_FINALITY_TAG=finalized
# CARD_AUTH_FINALITY_CONFIRMATIONS=10

# CARD_AUTH_TRACKER_INTERVAL=2s
# CARD_AUTH_RETURN_RETRY_INTERVAL=30s

# Operator transactions. Gas limits are integers above 21000; their defaults are set in st5.
# CARD_AUTH_FEE_BUMP_PERCENT=25
# CARD_AUTH_DEBIT_GAS_LIMIT=
# CARD_AUTH_REFUND_GAS_LIMIT=

# gRPC address of CRS v0.2.0 or later, locally localhost:50052. Unset: every non-USD authorization is declined.
# CRS_ADDRESS=

# CARD_AUTH_HTTP_PORT=8092
# CARD_AUTH_HEALTH_PORT=8093
# CARD_AUTH_SHUTDOWN_TIMEOUT=15s

# Tests (docs/test-plan-c1.md §1, docs/test-plan-s2.md §1). Owner role: runs the migrations and cleans tables.
TEST_DATABASE_URL=
# Role cas_server: used by the code under test.
TEST_DATABASE_URL_SERVER=
# Role cas_card_auth: used by card-auth under test.
TEST_DATABASE_URL_CARD_AUTH=

# Owner role. Used only by make migrate-up, migrate-down and migrate-version.
MIGRATE_DATABASE_URL=

# Owner role. Used only by casctl.
CASCTL_DATABASE_URL=
