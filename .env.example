# Environment of server (SRS - Core §3.1). Copy to .env; .env is ignored by git.
# Required variables have no value here. Optional ones are commented out with their default.

# Standard base64 of exactly 32 bytes.
CAS_MASTER_KEY=
# CAS_MASTER_KEY_VERSION=1

# PostgreSQL, role cas_server.
DATABASE_URL=
# DB_POOL_MAX_CONNS=10
# DB_POOL_MIN_CONNS=2

# GRPC_PORT=50053
# HEALTH_HTTP_PORT=8091

# LOG_LEVEL=info
# LOG_FORMAT=json

# Go durations, such as 30s or 1h.
# SHUTDOWN_TIMEOUT=15s
# SYNC_TICK=1s
# SYNC_WORKERS=4
# SYNC_LOCK_RETRY=10s
# SYNC_FAILURE_THRESHOLD=5
# SYNC_BACKOFF_INITIAL=30s
# SYNC_BACKOFF_MAX=1h
# TRIGGER_SYNC_COOLDOWN=60s
# KEY_CHECK_INTERVAL=24h

# Development and demo only.
# ENABLE_FAKE_SOURCE=false

# Tests (docs/test-plan-c1.md §1). Owner role: runs the migrations and cleans tables.
TEST_DATABASE_URL=
# Role cas_server: used by the code under test.
TEST_DATABASE_URL_SERVER=

# Owner role. Used only by make migrate-up, migrate-down and migrate-version.
MIGRATE_DATABASE_URL=

# Owner role. Used only by casctl.
CASCTL_DATABASE_URL=
